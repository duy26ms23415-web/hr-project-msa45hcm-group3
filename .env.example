# ==========================================
# CẤU HÌNH HỆ THỐNG HR MANAGEMENT WITH AI
# ==========================================

# Môi trường: development | staging | production
ENVIRONMENT=development
PROJECT_NAME="HR Management with AI"
API_V1_PREFIX="/api/v1"

# Cấu hình CSDL PostgreSQL
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=hr_user
POSTGRES_PASSWORD=hr_secret_password
POSTGRES_DB=hr_management_db

# Chuỗi kết nối Database (SQLAlchemy Async và Sync cho Alembic)
DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_SERVER}:${POSTGRES_PORT}/${POSTGRES_DB}
SYNC_DATABASE_URL=postgresql+psycopg2://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_SERVER}:${POSTGRES_PORT}/${POSTGRES_DB}

# Bảo mật & JWT
SECRET_KEY=change_this_to_a_very_secure_random_string_32_bytes_minimum
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480
REFRESH_TOKEN_EXPIRE_DAYS=7

# Token bảo mật dành riêng cho Kiosk Web (quét thẻ QR)
KIOSK_API_SECRET_KEY=kiosk_secret_device_authorization_token_hr_group3

# Trí tuệ nhân tạo (Google Gemini)
# Opt-in only; fallback works without Gemini.
GEMINI_ENABLED=false
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL_NAME=gemini-3.6-flash
GEMINI_INTENT_TIMEOUT_SECONDS=15
GEMINI_POLICY_TIMEOUT_SECONDS=15
AI_KNOWLEDGE_STORAGE_DIR=storage/private/ai-knowledge
AI_KNOWLEDGE_MAX_UPLOAD_BYTES=10485760
REPORT_STORAGE_DIR=storage/private/reports

# CORS (Frontend React)
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
